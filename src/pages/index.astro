---
import LandingLayout from "../layouts/LandingLayout.astro";

const services = [
  {
    no: "01",
    action: "調査する",
    title: "住環境インスペクション",
    description:
      "住宅の外側にある、街の暮らしやすさを点検します。公的データだけでは見えない生活の実像を、現地踏査と観察から捉えます。",
    items: ["現地踏査・写真記録", "歩行・交通・買い物環境調査", "治安・近隣住人・町内会調査"],
    tags: ["自治体", "移住検討者"],
    tone: "clay",
  },
  {
    no: "02",
    action: "蓄積する",
    title: "住環境アーカイブ",
    description:
      "地域の統計、地図、写真、観察記録を、あとから比較・検証できる形で蓄積。暮らしを選ぶための判断材料として公開します。",
    items: ["都市住環境図鑑の運営", "地域間比較・情報可視化", "各種学会への情報発信"],
    tags: ["移住検討者", "研究者"],
    tone: "sage",
  },
  {
    no: "03",
    action: "整理する",
    title: "IT基盤最適化支援",
    description:
      "過剰なIT投資や外部依存を見直し、AIとクラウドを活用した、無理なく内製・運用できる情報基盤へ再設計します。",
    items: [
      "ホームページ・IT基盤の投資コスト最適化",
      "SaaS・AIによる内製化",
      "社内データ整備・KPI策定・BIによる可視化",
    ],
    tags: ["自治体", "小規模事業者"],
    tone: "mist",
  },
];
---

<LandingLayout>
  <header class="lp-header">
  <a class="lp-brand" href="#top" aria-label="地域住環境情報設計 トップへ">
    <img
      class="lp-brand-logo"
      src="/images/logo-horizontal.svg"
      alt="地域住環境情報設計"
    />
  </a>
    <nav aria-label="メインナビゲーション">
      <a href="#services">事業内容</a>
      <a href="/about/">活動について</a>
      <a class="nav-contact" href="#contact">お問い合わせ</a>
    </nav>
  </header>

  <main>
    <section class="lp-hero" id="top">
      <div class="hero-copy">
        <!-- <p class="lp-eyebrow">REGIONAL ENVIRONMENT &amp; LIVING INFORMATION VISUALIZATION EVALUATION</p> -->
        <h1>暮らしの<br />解像度を<br />上げる。</h1>
        <p class="hero-lead">
          地域の暮らしを現地で調べ、記録し、<br />
          人と組織が判断できる情報へと整えます。
        </p>
        <div class="hero-actions">
          <a class="primary-button" href="#services">事業内容を見る <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#contact">相談する <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hero-graphic" role="img" aria-label="地域の地形と都市構造を表した抽象図">
        <div class="map-grid"></div>
        <div class="contour contour-one"></div>
        <div class="contour contour-two"></div>
        <div class="contour contour-three"></div>
        <span class="coordinate">33.68°N</span>
        <span class="data-point"><i></i> FIELD / DATA</span>
        <span class="city-block block-one"></span>
        <span class="city-block block-two"></span>
        <span class="city-block block-three"></span>
        <span class="city-block block-accent"></span>
        <strong class="graphic-copy">LOCAL CONDITIONS<br />/ CONTEXT</strong>
      </div>
    </section>

    <section class="services" id="services">
      <div class="section-heading">
        <h2>事業内容</h2>
        <p>住環境調査と情報整理、その両側を行き来しながら、暮らしの解像度向上に貢献します。</p>
      </div>

      <div class="service-grid">
        {services.map((service) => (
          <article class:list={["service-card", service.tone]}>
            <div class="card-top">
              <span class="number">{service.no}</span>
              <div class="tags">
                {service.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
            <div class="card-body">
              <p class="action">{service.action}</p>
              <h3>{service.title}</h3>
              <p class="description">{service.description}</p>
              <ul>
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <a class="round-link" href="#contact" aria-label={`${service.title}について相談する`}>↗</a>
          </article>
        ))}
      </div>
    </section>

<section class="contact" id="contact">
  <div class="contact-panel">
    <p class="contact-label">CONTACT</p>
    <p class="contact-note">調査のご相談、情報基盤の見直し、共同研究など。構想段階からお話を伺います。</p>
    <a class="email-link" href="mailto:contact@relive-design.com">
      <span>contact@relive-design.com</span><span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
  </main>

  <footer class="lp-footer">
    <a class="footer-brand" href="#top" aria-label="ページ上部へ戻る">
      <img
        class="footer-brand-logo"
        src="/images/logo-horizontal.svg"
        alt="地域住環境情報設計"
      />
    </a>

    <p>© 2026 Regional Environment &amp; Living Information Visualization Evaluation</p>
  </footer>
</LandingLayout>
